# Core application data
IRS_DB_PATH=db/irs990.db
# Windows example: C:/Projects/IRSDB/XML
# Linux example: /srv/irs990-data/xml
IRS_XML_ROOT=C:/path/to/xml
IRS_XML_INVENTORY_PATH=db/irs990_sources.db

# OLMS labor-organization sidecar and unpacked annual bulk data
OLMS_DB_PATH=db/olms.db
# Windows example: C:/Projects/IRSDB/OLMS/unpacked
# Linux example: /srv/irs990-data/olms/unpacked
OLMS_DATA_ROOT=C:/path/to/olms/unpacked

# Optional parent launcher link shown in the application header
TOOLBOX_HOME_URL=

# Optional enhanced grant-matching workspace
IRS_PROJECT_DIR=.
# Optional; when blank, grant_matching_work.db is discovered beside IRS_DB_PATH.
IRS_GRANT_WORK_DB_PATH=

# Optional public-record integrations for the fraud/risk dashboard
# FAC/FEC/SAM keys are kept in the environment and are never placed in request URLs shown by the app.
FAC_API_KEY=
SAM_API_KEY=
# Personal no-role SAM keys may be limited to 10 requests/day. Defaults use one
# primary-EIN FAC UEI and at most three SAM calls per uncached dashboard lookup.
SAM_MAX_UEIS=1
SAM_REQUEST_BUDGET=3
FEC_API_KEY=
# LDA.gov permits anonymous access; a token raises the rate limit.
LDA_API_KEY=
# Optional local public-record/network sidecars; defaults shown when blank/unset.
FAC_DB_PATH=db/fac_audits.db
IRS_SCREENING_DB_PATH=db/screening_data.db
# Optional ignored download cache used by build_screening_sidecar.py.
IRS_SCREENING_CACHE_DIR=downloads/screening
IRS_RISK_NETWORK_DB_PATH=db/risk_network.db

# Optional Ollama integration
OLLAMA_ENDPOINTS=http://localhost:11434/api/chat
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=
OLLAMA_COMPLEXITY_CONFIG=config/ollama_complexity.json
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=1000
# OLLAMA_TIMEOUT=180
